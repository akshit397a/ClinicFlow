# Copy to .env.local and fill in your Supabase project's values.
# Find these in Supabase: Project Settings -> Database / API.

# Prisma Database Connections (Supabase PostgreSQL)
# Transaction pooler URL (port 6543) or direct connection:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) for migrations:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Public values (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required because every write goes through trusted server-side
# code (Server Actions) using the service role. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key